{
  "manifest_version": 3,
  "name": "Safari Chat",
  "version": "0.1.0",
  "description": "An independent ChatGPT companion: chat, page context, and permission-based browser actions in Safari.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "nativeMessaging"],
  "host_permissions": ["https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "scripts": ["background.bundle.js"] },
  "action": { "default_title": "Open Safari Chat", "default_icon": { "32": "icons/icon-32.png", "64": "icons/icon-64.png" } },
  "icons": { "48": "icons/icon-48.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png" },
  "commands": { "_execute_action": { "suggested_key": { "mac": "Command+Shift+Period" }, "description": "Open Safari Chat" } },
  "web_accessible_resources": [{ "resources": ["panel/panel.html", "panel/*", "core/*", "icons/*"], "matches": ["http://*/*", "https://*/*"] }],
  "content_security_policy": { "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://api.openai.com; object-src 'none'; base-uri 'none'" }
}
